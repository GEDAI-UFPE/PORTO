# -----------------------------------------------------------------------------
# dea.order.R
# Corrected ordinal DEA / Benefit-of-the-Doubt multiplier model (no ties).
#
# Main corrections relative to the former routine:
#   1) If X = NULL and Y is supplied, a SINGLE unit input is created (n x 1),
#      as required by the standard BoD formulation.
#   2) Weak = TRUE (default) implements benevolent/weak ordinal preferences:
#        virtual contribution(rank 1) >= ... >= virtual contribution(rank s)
#      plus a surrogate lower bound for the least-preferred indicator.
#   3) Weak = FALSE implements the strong/strict formulation:
#      each virtual share is fixed to its surrogate share.
#   4) VRS uses a truly free intercept represented as omega+ - omega-, because
#      lpSolve variables are nonnegative by default.
#   5) This function is for rankings WITHOUT ties. Use dea.order.ties() when
#      a row of OX or OY contains tied priorities.
#
# Gamma: optional moderate preference intensity (0 to 1).
# Surrogate schemes: ROC, RS, RR, RE, EW.
# RE uses ALPHA = 2 by default.
# -----------------------------------------------------------------------------

dea.order <- function(X = NULL, Y = NULL, OX = NULL, OY = NULL,
                      RTS = "crs", ORIENTATION = "out",
                      SURROGATE = "ROC", Weak = TRUE,
                      ALPHA = 2, AUTO_CRS_BOD = TRUE, Gamma = NULL) {

  if (!requireNamespace("lpSolve", quietly = TRUE)) {
    stop("Package 'lpSolve' is required. Install it with install.packages('lpSolve').")
  }

  # ----- Local helpers --------------------------------------------------------
  .base_surrogate <- function(s, method = "ROC", alpha = 2) {
    method <- toupper(method)
    r <- seq_len(s)
    if (method == "ROC") {
      w <- vapply(r, function(j) sum(1 / seq.int(j, s)) / s, numeric(1))
    } else if (method == "RS") {
      w <- 2 * (s + 1 - r) / (s * (s + 1))
    } else if (method == "RR") {
      w <- (1 / r) / sum(1 / r)
    } else if (method == "RE") {
      if (!is.finite(alpha) || alpha <= 0) stop("ALPHA must be positive for RE weights.")
      w <- exp(-alpha * log(r)) / sum(exp(-alpha * log(r)))
    } else if (method == "EW") {
      w <- rep(1 / s, s)
    } else {
      stop("SURROGATE must be one of 'ROC', 'RS', 'RR', 'RE', or 'EW'.")
    }
    as.numeric(w / sum(w))
  }

  .rank_to_surrogate_no_ties <- function(rank_matrix, method, alpha) {
    rank_matrix <- as.matrix(rank_matrix)
    n <- nrow(rank_matrix)
    s <- ncol(rank_matrix)

    if (!is.numeric(rank_matrix) || any(!is.finite(rank_matrix))) stop("Ranks must be finite numeric values.")
    if (all(rank_matrix == 0)) {
      return(list(active = FALSE,
                  positions = matrix(0, n, s),
                  tau = matrix(0, n, s)))
    }
    if (any(!is.finite(rank_matrix)) || any(rank_matrix <= 0)) {
      stop("A rank matrix must be either all zeros (no restrictions) or contain positive finite ranks.")
    }

    pos <- matrix(NA_real_, n, s)
    tau <- matrix(NA_real_, n, s)
    base <- .base_surrogate(s, method, alpha)

    for (o in seq_len(n)) {
      rr <- as.numeric(rank_matrix[o, ])
      if (anyDuplicated(rr)) {
        stop(paste0("Tied ranks detected in row ", o,
                    ". Use dea.order.ties() for tied ordinal priorities."))
      }
      # Convert arbitrary ordinal labels to positions 1,...,s.
      ord <- order(rr, seq_along(rr))
      pp <- integer(s)
      pp[ord] <- seq_len(s)
      pos[o, ] <- pp
      tau[o, ] <- base[pp]
    }

    list(active = TRUE, positions = pos, tau = tau)
  }

  .append <- function(A, dir, rhs, row, sense, b) {
    A[[length(A) + 1L]] <- row
    dir <- c(dir, sense)
    rhs <- c(rhs, b)
    list(A = A, dir = dir, rhs = rhs)
  }

  # ----- Validation / default BoD setup --------------------------------------
  if (!is.logical(Weak) || length(Weak) != 1L || is.na(Weak)) {
    stop("Weak must be TRUE (weak/benevolent) or FALSE (strong/strict).")
  }

  if (is.null(Gamma)) Gamma <- if (Weak) 0 else 1
  if (!is.numeric(Gamma) || length(Gamma) != 1L ||
      !is.finite(Gamma) || Gamma < 0 || Gamma > 1) {
    stop("Gamma must be NULL or a finite number between 0 and 1.")
  }
  if (!Weak && Gamma != 1) stop("Weak=FALSE requires Gamma=1 (or NULL).")
  Weak <- Gamma < 1
  if (!is.character(SURROGATE) || length(SURROGATE) != 1L ||
      is.na(SURROGATE) || !toupper(SURROGATE) %in% c("ROC", "RS", "RR", "RE", "EW")) {
    stop("SURROGATE must be ROC, RS, RR, RE or EW.")
  }
  if (!is.numeric(ALPHA) || length(ALPHA) != 1L || !is.finite(ALPHA) || ALPHA <= 0) {
    stop("ALPHA must be a finite positive number.")
  }
  RTS <- tolower(RTS)
  if (!RTS %in% c("crs", "vrs")) stop("RTS must be 'crs' or 'vrs'.")
  ORIENTATION <- tolower(ORIENTATION)
  if (!ORIENTATION %in% c("out", "in")) stop("ORIENTATION must be 'out' or 'in'.")

  if (is.null(X) && is.null(Y)) stop("At least one of X or Y must be supplied.")

  auto_unit_input <- FALSE
  auto_unit_output <- FALSE

  if (is.null(X)) {
    Y <- as.matrix(Y)
    if (nrow(Y) < 1L || ncol(Y) < 1L) stop("Y must be a non-empty matrix.")
    X <- matrix(1, nrow = nrow(Y), ncol = 1L,
                dimnames = list(rownames(Y), "UnitInput"))
    auto_unit_input <- TRUE
  }
  if (is.null(Y)) {
    X <- as.matrix(X)
    if (nrow(X) < 1L || ncol(X) < 1L) stop("X must be a non-empty matrix.")
    Y <- matrix(1, nrow = nrow(X), ncol = 1L,
                dimnames = list(rownames(X), "UnitOutput"))
    auto_unit_output <- TRUE
  }

  X <- as.matrix(X)
  Y <- as.matrix(Y)
  if (nrow(X) < 1L || ncol(X) < 1L || nrow(Y) < 1L || ncol(Y) < 1L) {
    stop("X and Y must be non-empty matrices.")
  }
  if (!is.logical(AUTO_CRS_BOD) || length(AUTO_CRS_BOD) != 1L || is.na(AUTO_CRS_BOD)) {
    stop("AUTO_CRS_BOD must be TRUE or FALSE.")
  }
  storage.mode(X) <- "double"
  storage.mode(Y) <- "double"

  if (nrow(X) != nrow(Y)) stop("X and Y must have the same number of rows (DMUs).")
  if (any(!is.finite(X)) || any(!is.finite(Y))) stop("X and Y must contain only finite values.")
  if (any(X < 0) || any(Y < 0)) stop("This multiplier formulation requires nonnegative X and Y.")

  n <- nrow(X)
  m <- ncol(X)
  s <- ncol(Y)

  if (is.null(OX)) OX <- matrix(0, nrow = n, ncol = m)
  if (is.null(OY)) OY <- matrix(0, nrow = n, ncol = s)
  OX <- as.matrix(OX)
  OY <- as.matrix(OY)
  if (!all(dim(OX) == c(n, m))) stop("OX must have the same dimensions as X.")
  if (!all(dim(OY) == c(n, s))) stop("OY must have the same dimensions as Y.")

  # A VRS radial multiplier model with an identical unit input is degenerate for
  # standard output-maximizing BoD. The usual BoD model is CRS.
  RTS_requested <- RTS
  if ((auto_unit_input || auto_unit_output) && RTS == "vrs" && AUTO_CRS_BOD) {
    warning("An automatic unit input or output can make radial VRS BoD degenerate; RTS has been set to 'crs'.")
    RTS <- "crs"
  }

  rx <- .rank_to_surrogate_no_ties(OX, SURROGATE, ALPHA)
  ry <- .rank_to_surrogate_no_ties(OY, SURROGATE, ALPHA)

  # ----- Storage --------------------------------------------------------------
  efficiency <- rep(NA_real_, n)
  objective_raw <- rep(NA_real_, n)
  solver_status <- rep(NA_integer_, n)
  weights_input <- matrix(NA_real_, n, m, dimnames = list(rownames(X), colnames(X)))
  weights_output <- matrix(NA_real_, n, s, dimnames = list(rownames(Y), colnames(Y)))
  virtual_input <- matrix(NA_real_, n, m, dimnames = list(rownames(X), colnames(X)))
  virtual_output <- matrix(NA_real_, n, s, dimnames = list(rownames(Y), colnames(Y)))
  potential_improvement <- matrix(NA_real_, n, max(m, s))

  # ----- DEA loop -------------------------------------------------------------
  for (o in seq_len(n)) {

    # Variables are [v_1,...,v_m, u_1,...,u_s] under CRS and
    # [v, u, omega_plus, omega_minus] under VRS, where
    # omega = omega_plus - omega_minus is free.
    if (RTS == "crs") {
      nv <- m + s
      op <- om <- NA_integer_
    } else {
      nv <- m + s + 2L
      op <- m + s + 1L
      om <- m + s + 2L
    }

    A <- list()
    cdir <- character()
    crhs <- numeric()

    add_constraint <- function(row, sense, b) {
      tmp <- .append(A, cdir, crhs, row, sense, b)
      A <<- tmp$A
      cdir <<- tmp$dir
      crhs <<- tmp$rhs
    }

    if (ORIENTATION == "out") {
      # Input-normalized, output-maximizing multiplier / BoD formulation:
      # max u'y_o - omega, s.t. u'y_j - v'x_j - omega <= 0,
      # v'x_o = 1. For CRS omega = 0.
      obj <- numeric(nv)
      obj[(m + 1L):(m + s)] <- Y[o, ]
      if (RTS == "vrs") {
        obj[op] <- -1
        obj[om] <-  1
      }
      direction <- "max"

      for (j in seq_len(n)) {
        row <- numeric(nv)
        row[seq_len(m)] <- -X[j, ]
        row[m + seq_len(s)] <- Y[j, ]
        if (RTS == "vrs") {
          row[op] <- -1
          row[om] <-  1
        }
        add_constraint(row, "<=", 0)
      }
      row <- numeric(nv)
      row[seq_len(m)] <- X[o, ]
      add_constraint(row, "=", 1)

    } else {
      # Output-oriented BCC/CCR dual form:
      # min v'x_o + omega, s.t. u'y_j - v'x_j - omega <= 0,
      # u'y_o = 1. Returned efficiency is 1 / objective.
      obj <- numeric(nv)
      obj[seq_len(m)] <- X[o, ]
      if (RTS == "vrs") {
        obj[op] <-  1
        obj[om] <- -1
      }
      direction <- "min"

      for (j in seq_len(n)) {
        row <- numeric(nv)
        row[seq_len(m)] <- -X[j, ]
        row[m + seq_len(s)] <- Y[j, ]
        if (RTS == "vrs") {
          row[op] <- -1
          row[om] <-  1
        }
        add_constraint(row, "<=", 0)
      }
      row <- numeric(nv)
      row[m + seq_len(s)] <- Y[o, ]
      add_constraint(row, "=", 1)
    }

    # ----- Ordinal restrictions: inputs --------------------------------------
    if (rx$active) {
      pos <- rx$positions[o, ]
      tau <- rx$tau[o, ]
      order_idx <- order(pos)

      # Contribution coefficient vector for each input: x_io * v_i.
      input_contrib_row <- function(i) {
        rr <- numeric(nv)
        rr[i] <- X[o, i]
        rr
      }
      input_total_row <- numeric(nv)
      input_total_row[seq_len(m)] <- X[o, ]

      if (Weak) {
        if (m >= 2L) {
          for (h in seq_len(m - 1L)) {
            a <- order_idx[h]
            b <- order_idx[h + 1L]
            add_constraint(input_contrib_row(a) - input_contrib_row(b) -
                           Gamma * (tau[a] - tau[b]) * input_total_row, ">=", 0)
          }
        }
        least <- order_idx[m]
        add_constraint(input_contrib_row(least) - tau[least] * input_total_row, ">=", 0)
      } else {
        # Exact surrogate virtual shares. The final equality is redundant because
        # sum(tau)=1, so s-1 independent equalities are sufficient.
        if (m >= 2L) {
          for (i in seq_len(m - 1L)) {
            add_constraint(input_contrib_row(i) - tau[i] * input_total_row, "=", 0)
          }
        }
      }
    }

    # ----- Ordinal restrictions: outputs -------------------------------------
    if (ry$active) {
      pos <- ry$positions[o, ]
      tau <- ry$tau[o, ]
      order_idx <- order(pos)

      output_contrib_row <- function(r) {
        rr <- numeric(nv)
        rr[m + r] <- Y[o, r]
        rr
      }
      output_total_row <- numeric(nv)
      output_total_row[m + seq_len(s)] <- Y[o, ]

      if (Weak) {
        if (s >= 2L) {
          for (h in seq_len(s - 1L)) {
            a <- order_idx[h]
            b <- order_idx[h + 1L]
            add_constraint(output_contrib_row(a) - output_contrib_row(b) -
                           Gamma * (tau[a] - tau[b]) * output_total_row, ">=", 0)
          }
        }
        least <- order_idx[s]
        add_constraint(output_contrib_row(least) - tau[least] * output_total_row, ">=", 0)
      } else {
        if (s >= 2L) {
          for (r in seq_len(s - 1L)) {
            add_constraint(output_contrib_row(r) - tau[r] * output_total_row, "=", 0)
          }
        }
      }
    }

    const.mat <- do.call(rbind, A)
    fit <- lpSolve::lp(direction = direction,
                       objective.in = obj,
                       const.mat = const.mat,
                       const.dir = cdir,
                       const.rhs = crhs)

    solver_status[o] <- fit$status
    if (fit$status == 0L) {
      objective_raw[o] <- fit$objval
      weights_input[o, ] <- fit$solution[seq_len(m)]
      weights_output[o, ] <- fit$solution[m + seq_len(s)]

      if (ORIENTATION == "out") {
        efficiency[o] <- fit$objval
      } else {
        efficiency[o] <- if (fit$objval > 0) 1 / fit$objval else NA_real_
      }

      vin <- X[o, ] * weights_input[o, ]
      vout <- Y[o, ] * weights_output[o, ]
      virtual_input[o, ] <- if (sum(vin) > 0) vin / sum(vin) else NA_real_
      virtual_output[o, ] <- if (sum(vout) > 0) vout / sum(vout) else NA_real_

      # Only the CRS output-maximizing BoD score has the direct radial expansion
      # interpretation below. Other cases are intentionally left NA.
      if (ORIENTATION == "out" && RTS == "crs" && is.finite(efficiency[o]) && efficiency[o] > 0) {
        potential_improvement[o, seq_len(s)] <- (1 / efficiency[o] - 1) * Y[o, ]
      }
    }
  }

  if (any(solver_status != 0L)) {
    warning(sum(solver_status != 0L), " LP(s) did not return an optimal solution; inspect solver_status.")
  }

  list(
    weights_input = weights_input,
    weights_output = weights_output,
    efficiency = efficiency,
    objective_raw = objective_raw,
    potential_improvement = potential_improvement,
    virtual_input = virtual_input,
    virtual_output = virtual_output,
    surrogate_input = rx$tau,
    surrogate_output = ry$tau,
    ordinal_positions_input = rx$positions,
    ordinal_positions_output = ry$positions,
    solver_status = solver_status,
    preference = if (Gamma == 0) "weak" else if (Gamma == 1) "strict" else "moderate",
    Gamma = Gamma,
    Weak = Weak,
    RTS = RTS,
    RTS_requested = RTS_requested,
    ORIENTATION = ORIENTATION,
    SURROGATE = toupper(SURROGATE),
    ALPHA = ALPHA,
    auto_unit_input = auto_unit_input,
    auto_unit_output = auto_unit_output
  )
}

# -----------------------------------------------------------------------------
# dea.order.ties.R
# Corrected ordinal DEA / BoD multiplier model WITH tied priorities.
#
# Ties are handled by pooled positional surrogate mass. If t indicators occupy
# ordinal positions a,...,b, each tied indicator receives
#       mean(base_surrogate[a:b]).
# Example: ROC with four indicators and a two-way tie for first:
# (0.5208, 0.2708, 0.1458, 0.0625) ->
# (0.3958, 0.3958, 0.1458, 0.0625).
# This preserves indifference, ordering, and sum(tau)=1.
#
# Weak = TRUE  : weak/benevolent ordering + least-priority surrogate floor.
# Weak = FALSE : strong/strict exact surrogate virtual shares.
# -----------------------------------------------------------------------------

dea.order.ties <- function(X = NULL, Y = NULL, OX = NULL, OY = NULL,
                           RTS = "crs", ORIENTATION = "out",
                           SURROGATE = "ROC", Weak = TRUE,
                           ALPHA = 2, TIES = "pooled",
                           AUTO_CRS_BOD = TRUE, Gamma = NULL) {

  if (!requireNamespace("lpSolve", quietly = TRUE)) {
    stop("Package 'lpSolve' is required. Install it with install.packages('lpSolve').")
  }

  if (tolower(TIES) != "pooled") {
    stop("The corrected tie treatment is TIES='pooled'. Legacy best/worst/average/sequential rank substitution does not preserve the surrogate unit-sum structure.")
  }

  .base_surrogate <- function(s, method = "ROC", alpha = 2) {
    method <- toupper(method)
    r <- seq_len(s)
    if (method == "ROC") {
      w <- vapply(r, function(j) sum(1 / seq.int(j, s)) / s, numeric(1))
    } else if (method == "RS") {
      w <- 2 * (s + 1 - r) / (s * (s + 1))
    } else if (method == "RR") {
      w <- (1 / r) / sum(1 / r)
    } else if (method == "RE") {
      if (!is.finite(alpha) || alpha <= 0) stop("ALPHA must be positive for RE weights.")
      w <- exp(-alpha * log(r)) / sum(exp(-alpha * log(r)))
    } else if (method == "EW") {
      w <- rep(1 / s, s)
    } else {
      stop("SURROGATE must be one of 'ROC', 'RS', 'RR', 'RE', or 'EW'.")
    }
    as.numeric(w / sum(w))
  }

  .tie_rank_info <- function(rank_matrix, method, alpha) {
    rank_matrix <- as.matrix(rank_matrix)
    n <- nrow(rank_matrix)
    s <- ncol(rank_matrix)

    if (!is.numeric(rank_matrix) || any(!is.finite(rank_matrix))) stop("Ranks must be finite numeric values.")
    if (all(rank_matrix == 0)) {
      return(list(active = FALSE,
                  positions = matrix(0, n, s),
                  tau = matrix(0, n, s),
                  blocks = vector("list", n)))
    }
    if (any(!is.finite(rank_matrix)) || any(rank_matrix <= 0)) {
      stop("A rank matrix must be either all zeros (no restrictions) or contain positive finite ranks.")
    }

    base <- .base_surrogate(s, method, alpha)
    pos <- matrix(NA_real_, n, s)
    tau <- matrix(NA_real_, n, s)
    blocks_all <- vector("list", n)

    for (o in seq_len(n)) {
      rr <- as.numeric(rank_matrix[o, ])
      levels <- sort(unique(rr))
      blocks <- lapply(levels, function(z) which(rr == z))
      blocks_all[[o]] <- blocks
      cursor <- 1L

      for (bl in blocks) {
        t <- length(bl)
        occupied <- cursor:(cursor + t - 1L)
        pooled <- sum(base[occupied]) / t
        tau[o, bl] <- pooled
        # All members of the tie block share the same ordinal block position.
        pos[o, bl] <- mean(occupied)
        cursor <- cursor + t
      }
      if (abs(sum(tau[o, ]) - 1) > 1e-10) stop("Internal tie-surrogate error: shares do not sum to one.")
    }

    list(active = TRUE, positions = pos, tau = tau, blocks = blocks_all)
  }

  .append <- function(A, dir, rhs, row, sense, b) {
    A[[length(A) + 1L]] <- row
    dir <- c(dir, sense)
    rhs <- c(rhs, b)
    list(A = A, dir = dir, rhs = rhs)
  }

  if (!is.logical(Weak) || length(Weak) != 1L || is.na(Weak)) {
    stop("Weak must be TRUE (weak/benevolent) or FALSE (strong/strict).")
  }

  if (is.null(Gamma)) Gamma <- if (Weak) 0 else 1
  if (!is.numeric(Gamma) || length(Gamma) != 1L ||
      !is.finite(Gamma) || Gamma < 0 || Gamma > 1) {
    stop("Gamma must be NULL or a finite number between 0 and 1.")
  }
  if (!Weak && Gamma != 1) stop("Weak=FALSE requires Gamma=1 (or NULL).")
  Weak <- Gamma < 1
  if (!is.character(SURROGATE) || length(SURROGATE) != 1L ||
      is.na(SURROGATE) || !toupper(SURROGATE) %in% c("ROC", "RS", "RR", "RE", "EW")) {
    stop("SURROGATE must be ROC, RS, RR, RE or EW.")
  }
  if (!is.numeric(ALPHA) || length(ALPHA) != 1L || !is.finite(ALPHA) || ALPHA <= 0) {
    stop("ALPHA must be a finite positive number.")
  }
  RTS <- tolower(RTS)
  if (!RTS %in% c("crs", "vrs")) stop("RTS must be 'crs' or 'vrs'.")
  ORIENTATION <- tolower(ORIENTATION)
  if (!ORIENTATION %in% c("out", "in")) stop("ORIENTATION must be 'out' or 'in'.")
  if (is.null(X) && is.null(Y)) stop("At least one of X or Y must be supplied.")

  auto_unit_input <- FALSE
  auto_unit_output <- FALSE
  if (is.null(X)) {
    Y <- as.matrix(Y)
    X <- matrix(1, nrow = nrow(Y), ncol = 1L,
                dimnames = list(rownames(Y), "UnitInput"))
    auto_unit_input <- TRUE
  }
  if (is.null(Y)) {
    X <- as.matrix(X)
    Y <- matrix(1, nrow = nrow(X), ncol = 1L,
                dimnames = list(rownames(X), "UnitOutput"))
    auto_unit_output <- TRUE
  }

  X <- as.matrix(X); Y <- as.matrix(Y)
  if (nrow(X) < 1L || ncol(X) < 1L || nrow(Y) < 1L || ncol(Y) < 1L) {
    stop("X and Y must be non-empty matrices.")
  }
  if (!is.logical(AUTO_CRS_BOD) || length(AUTO_CRS_BOD) != 1L || is.na(AUTO_CRS_BOD)) {
    stop("AUTO_CRS_BOD must be TRUE or FALSE.")
  }
  storage.mode(X) <- "double"; storage.mode(Y) <- "double"
  if (nrow(X) != nrow(Y)) stop("X and Y must have the same number of rows (DMUs).")
  if (any(!is.finite(X)) || any(!is.finite(Y))) stop("X and Y must contain only finite values.")
  if (any(X < 0) || any(Y < 0)) stop("This multiplier formulation requires nonnegative X and Y.")

  n <- nrow(X); m <- ncol(X); s <- ncol(Y)
  if (is.null(OX)) OX <- matrix(0, n, m)
  if (is.null(OY)) OY <- matrix(0, n, s)
  OX <- as.matrix(OX); OY <- as.matrix(OY)
  if (!all(dim(OX) == c(n, m))) stop("OX must have the same dimensions as X.")
  if (!all(dim(OY) == c(n, s))) stop("OY must have the same dimensions as Y.")

  RTS_requested <- RTS
  if ((auto_unit_input || auto_unit_output) && RTS == "vrs" && AUTO_CRS_BOD) {
    warning("An automatic unit input or output can make radial VRS BoD degenerate; RTS has been set to 'crs'.")
    RTS <- "crs"
  }

  rx <- .tie_rank_info(OX, SURROGATE, ALPHA)
  ry <- .tie_rank_info(OY, SURROGATE, ALPHA)

  efficiency <- objective_raw <- rep(NA_real_, n)
  solver_status <- rep(NA_integer_, n)
  weights_input <- matrix(NA_real_, n, m, dimnames = list(rownames(X), colnames(X)))
  weights_output <- matrix(NA_real_, n, s, dimnames = list(rownames(Y), colnames(Y)))
  virtual_input <- matrix(NA_real_, n, m, dimnames = list(rownames(X), colnames(X)))
  virtual_output <- matrix(NA_real_, n, s, dimnames = list(rownames(Y), colnames(Y)))
  potential_improvement <- matrix(NA_real_, n, max(m, s))

  for (o in seq_len(n)) {
    if (RTS == "crs") {
      nv <- m + s; op <- om <- NA_integer_
    } else {
      nv <- m + s + 2L; op <- m + s + 1L; om <- m + s + 2L
    }

    A <- list(); cdir <- character(); crhs <- numeric()
    add_constraint <- function(row, sense, b) {
      tmp <- .append(A, cdir, crhs, row, sense, b)
      A <<- tmp$A; cdir <<- tmp$dir; crhs <<- tmp$rhs
    }

    if (ORIENTATION == "out") {
      obj <- numeric(nv); obj[m + seq_len(s)] <- Y[o, ]
      if (RTS == "vrs") { obj[op] <- -1; obj[om] <- 1 }
      direction <- "max"
      for (j in seq_len(n)) {
        row <- numeric(nv); row[seq_len(m)] <- -X[j, ]; row[m + seq_len(s)] <- Y[j, ]
        if (RTS == "vrs") { row[op] <- -1; row[om] <- 1 }
        add_constraint(row, "<=", 0)
      }
      row <- numeric(nv); row[seq_len(m)] <- X[o, ]; add_constraint(row, "=", 1)
    } else {
      obj <- numeric(nv); obj[seq_len(m)] <- X[o, ]
      if (RTS == "vrs") { obj[op] <- 1; obj[om] <- -1 }
      direction <- "min"
      for (j in seq_len(n)) {
        row <- numeric(nv); row[seq_len(m)] <- -X[j, ]; row[m + seq_len(s)] <- Y[j, ]
        if (RTS == "vrs") { row[op] <- -1; row[om] <- 1 }
        add_constraint(row, "<=", 0)
      }
      row <- numeric(nv); row[m + seq_len(s)] <- Y[o, ]; add_constraint(row, "=", 1)
    }

    # ----- Input ordinal restrictions ----------------------------------------
    if (rx$active) {
      tau <- rx$tau[o, ]; blocks <- rx$blocks[[o]]
      contrib <- lapply(seq_len(m), function(i) {
        z <- numeric(nv); z[i] <- X[o, i]; z
      })
      total <- numeric(nv); total[seq_len(m)] <- X[o, ]

      if (Weak) {
        # Indifference within a tied block.
        for (bl in blocks) if (length(bl) > 1L) {
          for (k in bl[-1L]) add_constraint(contrib[[bl[1L]]] - contrib[[k]], "=", 0)
        }
        # Weak ordering between adjacent priority blocks.
        if (length(blocks) >= 2L) {
          for (h in seq_len(length(blocks) - 1L)) {
            a <- blocks[[h]][1L]; b <- blocks[[h + 1L]][1L]
            add_constraint(contrib[[a]] - contrib[[b]] -
                           Gamma * (tau[a] - tau[b]) * total, ">=", 0)
          }
        }
        # Surrogate lower bound only for the least-priority block.
        for (a in blocks[[length(blocks)]]) {
          add_constraint(contrib[[a]] - tau[a] * total, ">=", 0)
        }
      } else {
        # Exact surrogate shares. One equation is redundant because sum(tau)=1.
        if (m >= 2L) {
          for (i in seq_len(m - 1L)) add_constraint(contrib[[i]] - tau[i] * total, "=", 0)
        }
      }
    }

    # ----- Output ordinal restrictions ---------------------------------------
    if (ry$active) {
      tau <- ry$tau[o, ]; blocks <- ry$blocks[[o]]
      contrib <- lapply(seq_len(s), function(r) {
        z <- numeric(nv); z[m + r] <- Y[o, r]; z
      })
      total <- numeric(nv); total[m + seq_len(s)] <- Y[o, ]

      if (Weak) {
        for (bl in blocks) if (length(bl) > 1L) {
          for (k in bl[-1L]) add_constraint(contrib[[bl[1L]]] - contrib[[k]], "=", 0)
        }
        if (length(blocks) >= 2L) {
          for (h in seq_len(length(blocks) - 1L)) {
            a <- blocks[[h]][1L]; b <- blocks[[h + 1L]][1L]
            add_constraint(contrib[[a]] - contrib[[b]] -
                           Gamma * (tau[a] - tau[b]) * total, ">=", 0)
          }
        }
        for (a in blocks[[length(blocks)]]) {
          add_constraint(contrib[[a]] - tau[a] * total, ">=", 0)
        }
      } else {
        if (s >= 2L) {
          for (r in seq_len(s - 1L)) add_constraint(contrib[[r]] - tau[r] * total, "=", 0)
        }
      }
    }

    fit <- lpSolve::lp(direction = direction,
                       objective.in = obj,
                       const.mat = do.call(rbind, A),
                       const.dir = cdir,
                       const.rhs = crhs)
    solver_status[o] <- fit$status

    if (fit$status == 0L) {
      objective_raw[o] <- fit$objval
      weights_input[o, ] <- fit$solution[seq_len(m)]
      weights_output[o, ] <- fit$solution[m + seq_len(s)]
      efficiency[o] <- if (ORIENTATION == "out") fit$objval else if (fit$objval > 0) 1 / fit$objval else NA_real_

      vin <- X[o, ] * weights_input[o, ]
      vout <- Y[o, ] * weights_output[o, ]
      virtual_input[o, ] <- if (sum(vin) > 0) vin / sum(vin) else NA_real_
      virtual_output[o, ] <- if (sum(vout) > 0) vout / sum(vout) else NA_real_

      if (ORIENTATION == "out" && RTS == "crs" && is.finite(efficiency[o]) && efficiency[o] > 0) {
        potential_improvement[o, seq_len(s)] <- (1 / efficiency[o] - 1) * Y[o, ]
      }
    }
  }

  if (any(solver_status != 0L)) {
    warning(sum(solver_status != 0L), " LP(s) did not return an optimal solution; inspect solver_status.")
  }

  list(
    weights_input = weights_input,
    weights_output = weights_output,
    efficiency = efficiency,
    objective_raw = objective_raw,
    potential_improvement = potential_improvement,
    virtual_input = virtual_input,
    virtual_output = virtual_output,
    surrogate_input = rx$tau,
    surrogate_output = ry$tau,
    ordinal_positions_input = rx$positions,
    ordinal_positions_output = ry$positions,
    tie_blocks_input = rx$blocks,
    tie_blocks_output = ry$blocks,
    solver_status = solver_status,
    preference = if (Gamma == 0) "weak" else if (Gamma == 1) "strict" else "moderate",
    Gamma = Gamma,
    Weak = Weak,
    tie_method = "pooled positional surrogate mass",
    RTS = RTS,
    RTS_requested = RTS_requested,
    ORIENTATION = ORIENTATION,
    SURROGATE = toupper(SURROGATE),
    ALPHA = ALPHA,
    auto_unit_input = auto_unit_input,
    auto_unit_output = auto_unit_output
  )
}

# -----------------------------------------------------------------------------
# dir.dea.order.R
# Directional ordinal Benefit-of-the-Doubt model (NO tied priorities).
#
# Y  = desirable indicators (larger is better)
# B  = undesirable indicators (smaller is better)
# OY = ordinal priorities corresponding to Y
# OB = ordinal priorities corresponding to B
#
# The model follows the multiplier form of the directional BoD logic:
#   min beta_o = -u' y_o + p' b_o + omega
#   s.t.        -u' y_j + p' b_j + omega >= 0, for all j
#               u' g_y,o + p' g_b,o = 1
# with omega free under VRS and omega = 0 under CRS.
# The default direction is the data direction g_y,o = y_o, g_b,o = b_o.
# Hence directional virtual shares are u_r*y_ro and p_k*b_ko and sum to 1.
# The composite score is CI_o = 1 / (1 + beta_o).
#
# Weak = TRUE  : weak/benevolent ordering + least-priority surrogate floor.
# Weak = FALSE : strong/strict exact surrogate virtual shares.
#
# Use dir.dea.order.ties() when any row contains tied priorities.
# -----------------------------------------------------------------------------

dir.dea.order <- function(Y = NULL, B = NULL, OY = NULL, OB = NULL,
                          RTS = "vrs", SURROGATE = "ROC", Weak = TRUE,
                          ALPHA = 2, GY = NULL, GB = NULL, Gamma = NULL) {

  if (!requireNamespace("lpSolve", quietly = TRUE)) {
    stop("Package 'lpSolve' is required. Install it with install.packages('lpSolve').")
  }

  .base_surrogate <- function(s, method = "ROC", alpha = 2) {
    method <- toupper(method); r <- seq_len(s)
    if (method == "ROC") {
      w <- vapply(r, function(j) sum(1 / seq.int(j, s)) / s, numeric(1))
    } else if (method == "RS") {
      w <- 2 * (s + 1 - r) / (s * (s + 1))
    } else if (method == "RR") {
      w <- (1 / r) / sum(1 / r)
    } else if (method == "RE") {
      if (!is.finite(alpha) || alpha <= 0) stop("ALPHA must be positive for RE weights.")
      w <- exp(-alpha * log(r)) / sum(exp(-alpha * log(r)))
    } else if (method == "EW") {
      w <- rep(1 / s, s)
    } else stop("SURROGATE must be one of 'ROC', 'RS', 'RR', 'RE', or 'EW'.")
    as.numeric(w / sum(w))
  }

  .rank_info_no_ties <- function(R, method, alpha) {
    R <- as.matrix(R); n <- nrow(R); s <- ncol(R)
    if (!is.numeric(R) || any(!is.finite(R))) stop("Ranks must be finite numeric values.")
    if (all(R == 0)) return(list(active = FALSE, positions = matrix(0,n,s), tau = matrix(0,n,s)))
    if (any(!is.finite(R)) || any(R <= 0)) {
      stop("Rank matrices must be all zeros or contain positive finite ranks for every indicator.")
    }
    base <- .base_surrogate(s, method, alpha)
    pos <- tau <- matrix(NA_real_, n, s)
    for (o in seq_len(n)) {
      rr <- as.numeric(R[o, ])
      if (anyDuplicated(rr)) {
        stop(paste0("Tied ranks detected in row ", o, ". Use dir.dea.order.ties()."))
      }
      ord <- order(rr, seq_along(rr)); pp <- integer(s); pp[ord] <- seq_len(s)
      pos[o, ] <- pp; tau[o, ] <- base[pp]
    }
    list(active = TRUE, positions = pos, tau = tau)
  }

  .direction_row <- function(D, observed, o, label) {
    p <- ncol(observed)
    if (p == 0L) return(numeric(0))
    if (is.null(D)) return(as.numeric(observed[o, ]))
    if (is.vector(D) && !is.list(D)) {
      if (length(D) != p) stop(label, " must have length ", p, ".")
      z <- as.numeric(D)
    } else {
      D <- as.matrix(D)
      if (!all(dim(D) == dim(observed))) stop(label, " must have the same dimensions as its data matrix.")
      z <- as.numeric(D[o, ])
    }
    if (any(!is.finite(z)) || any(z < 0)) stop(label, " must be finite and nonnegative.")
    z
  }

  if (!is.logical(Weak) || length(Weak) != 1L || is.na(Weak)) {
    stop("Weak must be TRUE (weak/benevolent) or FALSE (strong/strict).")
  }
  if (is.null(Gamma)) Gamma <- if (Weak) 0 else 1
  if (!is.numeric(Gamma) || length(Gamma) != 1L ||
      !is.finite(Gamma) || Gamma < 0 || Gamma > 1) {
    stop("Gamma must be NULL or a finite number between 0 and 1.")
  }
  if (!Weak && Gamma != 1) stop("Weak=FALSE requires Gamma=1 (or NULL).")
  Weak <- Gamma < 1
  if (!is.character(SURROGATE) || length(SURROGATE) != 1L ||
      is.na(SURROGATE) || !toupper(SURROGATE) %in% c("ROC", "RS", "RR", "RE", "EW")) {
    stop("SURROGATE must be ROC, RS, RR, RE or EW.")
  }
  if (!is.numeric(ALPHA) || length(ALPHA) != 1L || !is.finite(ALPHA) || ALPHA <= 0) {
    stop("ALPHA must be a finite positive number.")
  }
  RTS <- tolower(RTS)
  if (!RTS %in% c("crs", "vrs")) stop("RTS must be 'crs' or 'vrs'.")
  if (is.null(Y) && is.null(B)) stop("At least one of Y (desirable) or B (undesirable) must be supplied.")

  if (!is.null(Y)) Y <- as.matrix(Y)
  if (!is.null(B)) B <- as.matrix(B)
  n <- if (!is.null(Y)) nrow(Y) else nrow(B)
  if (is.null(Y)) Y <- matrix(numeric(0), nrow = n, ncol = 0L)
  if (is.null(B)) B <- matrix(numeric(0), nrow = n, ncol = 0L)
  if (nrow(Y) != nrow(B)) stop("Y and B must have the same number of rows (DMUs).")
  storage.mode(Y) <- "double"; storage.mode(B) <- "double"
  if (any(!is.finite(Y)) || any(!is.finite(B))) stop("Y and B must contain only finite values.")
  if (any(Y < 0) || any(B < 0)) stop("Directional BoD requires nonnegative desirable and undesirable indicators.")

  ng <- ncol(Y); nb <- ncol(B); s <- ng + nb
  if (n < 1L || s < 1L) stop("At least one DMU and one indicator are required.")
  if (is.null(OY)) OY <- matrix(0, n, ng)
  if (is.null(OB)) OB <- matrix(0, n, nb)
  OY <- as.matrix(OY); OB <- as.matrix(OB)
  if (!all(dim(OY) == c(n, ng))) stop("OY must have the same dimensions as Y.")
  if (!all(dim(OB) == c(n, nb))) stop("OB must have the same dimensions as B.")

  R <- cbind(OY, OB)
  rr <- .rank_info_no_ties(R, SURROGATE, ALPHA)

  beta <- score <- rep(NA_real_, n)
  solver_status <- rep(NA_integer_, n)
  weights_desirable <- matrix(NA_real_, n, ng, dimnames = list(rownames(Y), colnames(Y)))
  weights_undesirable <- matrix(NA_real_, n, nb, dimnames = list(rownames(B), colnames(B)))
  virtual_share <- matrix(NA_real_, n, s)
  surrogate_share <- rr$tau
  for (o in seq_len(n)) {
    gy <- .direction_row(GY, Y, o, "GY")
    gb <- .direction_row(GB, B, o, "GB")
    if (sum(gy) + sum(gb) <= 0) stop("The directional vector must contain at least one positive component for every DMU.")

    # Variables: u (desirable), p (undesirable), and omega+ / omega- under VRS.
    if (RTS == "crs") {
      nv <- ng + nb; op <- om <- NA_integer_
    } else {
      nv <- ng + nb + 2L; op <- ng + nb + 1L; om <- ng + nb + 2L
    }

    obj <- numeric(nv)
    if (ng) obj[seq_len(ng)] <- -Y[o, ]
    if (nb) obj[ng + seq_len(nb)] <- B[o, ]
    if (RTS == "vrs") { obj[op] <- 1; obj[om] <- -1 }

    A <- list(); cdir <- character(); crhs <- numeric()
    add <- function(row, sense, rhs) {
      A[[length(A) + 1L]] <<- row
      cdir <<- c(cdir, sense)
      crhs <<- c(crhs, rhs)
    }

    # Common directional frontier.
    for (j in seq_len(n)) {
      row <- numeric(nv)
      if (ng) row[seq_len(ng)] <- -Y[j, ]
      if (nb) row[ng + seq_len(nb)] <- B[j, ]
      if (RTS == "vrs") { row[op] <- 1; row[om] <- -1 }
      add(row, ">=", 0)
    }

    # Directional normalization u'g_y + p'g_b = 1.
    row <- numeric(nv)
    if (ng) row[seq_len(ng)] <- gy
    if (nb) row[ng + seq_len(nb)] <- gb
    add(row, "=", 1)

    if (rr$active) {
      pos <- rr$positions[o, ]; tau <- rr$tau[o, ]; ord <- order(pos)
      contrib <- vector("list", s)
      if (ng) for (r in seq_len(ng)) {
        z <- numeric(nv); z[r] <- gy[r]; contrib[[r]] <- z
      }
      if (nb) for (k in seq_len(nb)) {
        z <- numeric(nv); z[ng + k] <- gb[k]; contrib[[ng + k]] <- z
      }

      if (Weak) {
        if (s >= 2L) for (h in seq_len(s - 1L)) {
          a <- ord[h]; b <- ord[h + 1L]
          add(contrib[[a]] - contrib[[b]], ">=", Gamma * (tau[a] - tau[b]))
        }
        least <- ord[s]
        add(contrib[[least]], ">=", tau[least])
      } else {
        # Normalization already forces the shares to sum to one; s-1 exact
        # share equalities imply the final one automatically.
        if (s >= 2L) for (r in seq_len(s - 1L)) add(contrib[[r]], "=", tau[r])
      }
    }

    fit <- lpSolve::lp(direction = "min", objective.in = obj,
                       const.mat = do.call(rbind, A),
                       const.dir = cdir, const.rhs = crhs)
    solver_status[o] <- fit$status

    if (fit$status == 0L) {
      beta[o] <- fit$objval
      # Numerical tolerance: beta should be >= 0 because the evaluated DMU is
      # itself one of the frontier constraints.
      if (beta[o] < 0 && beta[o] > -1e-8) beta[o] <- 0
      score[o] <- if (beta[o] >= 0) 1 / (1 + beta[o]) else NA_real_
      if (ng) weights_desirable[o, ] <- fit$solution[seq_len(ng)]
      if (nb) weights_undesirable[o, ] <- fit$solution[ng + seq_len(nb)]
      sh <- numeric(s)
      if (ng) sh[seq_len(ng)] <- gy * fit$solution[seq_len(ng)]
      if (nb) sh[ng + seq_len(nb)] <- gb * fit$solution[ng + seq_len(nb)]
      virtual_share[o, ] <- sh
    }
  }

  # Safe column names after computation.
  yn <- if (ng) { z <- colnames(Y); if (is.null(z)) paste0("Y",seq_len(ng)) else z } else character(0)
  bn <- if (nb) { z <- colnames(B); if (is.null(z)) paste0("B",seq_len(nb)) else z } else character(0)
  rownames(virtual_share) <- rownames(surrogate_share) <- if (ng) rownames(Y) else rownames(B)
  colnames(virtual_share) <- c(yn, bn)
  colnames(surrogate_share) <- c(yn, bn)

  if (any(solver_status != 0L)) {
    warning(sum(solver_status != 0L), " LP(s) did not return an optimal solution; inspect solver_status.")
  }

  list(
    efficiency = score,
    score = score,
    beta = beta,
    weights_desirable = weights_desirable,
    weights_undesirable = weights_undesirable,
    virtual_share = virtual_share,
    surrogate_share = surrogate_share,
    ordinal_positions = rr$positions,
    solver_status = solver_status,
    preference = if (Gamma == 0) "weak" else if (Gamma == 1) "strict" else "moderate",
    Gamma = Gamma,
    Weak = Weak,
    RTS = RTS,
    SURROGATE = toupper(SURROGATE),
    ALPHA = ALPHA,
    direction = if (is.null(GY) && is.null(GB)) "data direction" else "user supplied"
  )
}

# -----------------------------------------------------------------------------
# dir.dea.order.ties.R
# Directional ordinal Benefit-of-the-Doubt model WITH tied priorities.
#
# Y  = desirable indicators (larger is better)
# B  = undesirable indicators (smaller is better)
# OY = ordinal priorities for Y
# OB = ordinal priorities for B
#
# Ties use pooled positional surrogate mass. If a tie block occupies positions
# a,...,b, the total surrogate mass for those positions is divided equally among
# the tied indicators. This preserves indifference and sum(tau)=1.
#
# Weak = TRUE  : tied indicators have equal virtual shares; priority blocks are
#                weakly ordered; the least-priority block receives its surrogate
#                lower-bound share.
# Weak = FALSE : exact (strict/strong) tie-adjusted surrogate virtual shares.
# -----------------------------------------------------------------------------

dir.dea.order.ties <- function(Y = NULL, B = NULL, OY = NULL, OB = NULL,
                               RTS = "vrs", SURROGATE = "ROC", Weak = TRUE,
                               ALPHA = 2, TIES = "pooled",
                               GY = NULL, GB = NULL, Gamma = NULL) {

  if (!requireNamespace("lpSolve", quietly = TRUE)) {
    stop("Package 'lpSolve' is required. Install it with install.packages('lpSolve').")
  }
  if (tolower(TIES) != "pooled") {
    stop("The corrected tie treatment is TIES='pooled'. Legacy best/worst/average/sequential substitution is intentionally disabled.")
  }

  .base_surrogate <- function(s, method = "ROC", alpha = 2) {
    method <- toupper(method); r <- seq_len(s)
    if (method == "ROC") {
      w <- vapply(r, function(j) sum(1 / seq.int(j, s)) / s, numeric(1))
    } else if (method == "RS") {
      w <- 2 * (s + 1 - r) / (s * (s + 1))
    } else if (method == "RR") {
      w <- (1 / r) / sum(1 / r)
    } else if (method == "RE") {
      if (!is.finite(alpha) || alpha <= 0) stop("ALPHA must be positive for RE weights.")
      w <- exp(-alpha * log(r)) / sum(exp(-alpha * log(r)))
    } else if (method == "EW") {
      w <- rep(1 / s, s)
    } else stop("SURROGATE must be one of 'ROC', 'RS', 'RR', 'RE', or 'EW'.")
    as.numeric(w / sum(w))
  }

  .tie_rank_info <- function(R, method, alpha) {
    R <- as.matrix(R); n <- nrow(R); s <- ncol(R)
    if (!is.numeric(R) || any(!is.finite(R))) stop("Ranks must be finite numeric values.")
    if (all(R == 0)) {
      return(list(active = FALSE, positions = matrix(0,n,s), tau = matrix(0,n,s), blocks = vector("list",n)))
    }
    if (any(!is.finite(R)) || any(R <= 0)) {
      stop("Rank matrices must be all zeros or contain positive finite ranks for every indicator.")
    }
    base <- .base_surrogate(s, method, alpha)
    pos <- tau <- matrix(NA_real_, n, s)
    blocks_all <- vector("list", n)
    for (o in seq_len(n)) {
      rr <- as.numeric(R[o, ])
      lev <- sort(unique(rr))
      blocks <- lapply(lev, function(z) which(rr == z))
      blocks_all[[o]] <- blocks
      cursor <- 1L
      for (bl in blocks) {
        t <- length(bl); occupied <- cursor:(cursor + t - 1L)
        tau[o, bl] <- sum(base[occupied]) / t
        pos[o, bl] <- mean(occupied)
        cursor <- cursor + t
      }
      if (abs(sum(tau[o, ]) - 1) > 1e-10) stop("Internal tie-surrogate error: shares do not sum to one.")
    }
    list(active = TRUE, positions = pos, tau = tau, blocks = blocks_all)
  }

  .direction_row <- function(D, observed, o, label) {
    p <- ncol(observed)
    if (p == 0L) return(numeric(0))
    if (is.null(D)) return(as.numeric(observed[o, ]))
    if (is.vector(D) && !is.list(D)) {
      if (length(D) != p) stop(label, " must have length ", p, ".")
      z <- as.numeric(D)
    } else {
      D <- as.matrix(D)
      if (!all(dim(D) == dim(observed))) stop(label, " must have the same dimensions as its data matrix.")
      z <- as.numeric(D[o, ])
    }
    if (any(!is.finite(z)) || any(z < 0)) stop(label, " must be finite and nonnegative.")
    z
  }

  if (!is.logical(Weak) || length(Weak) != 1L || is.na(Weak)) {
    stop("Weak must be TRUE (weak/benevolent) or FALSE (strong/strict).")
  }
  if (is.null(Gamma)) Gamma <- if (Weak) 0 else 1
  if (!is.numeric(Gamma) || length(Gamma) != 1L ||
      !is.finite(Gamma) || Gamma < 0 || Gamma > 1) {
    stop("Gamma must be NULL or a finite number between 0 and 1.")
  }
  if (!Weak && Gamma != 1) stop("Weak=FALSE requires Gamma=1 (or NULL).")
  Weak <- Gamma < 1
  if (!is.character(SURROGATE) || length(SURROGATE) != 1L ||
      is.na(SURROGATE) || !toupper(SURROGATE) %in% c("ROC", "RS", "RR", "RE", "EW")) {
    stop("SURROGATE must be ROC, RS, RR, RE or EW.")
  }
  if (!is.numeric(ALPHA) || length(ALPHA) != 1L || !is.finite(ALPHA) || ALPHA <= 0) {
    stop("ALPHA must be a finite positive number.")
  }
  RTS <- tolower(RTS)
  if (!RTS %in% c("crs", "vrs")) stop("RTS must be 'crs' or 'vrs'.")
  if (is.null(Y) && is.null(B)) stop("At least one of Y (desirable) or B (undesirable) must be supplied.")

  if (!is.null(Y)) Y <- as.matrix(Y)
  if (!is.null(B)) B <- as.matrix(B)
  n <- if (!is.null(Y)) nrow(Y) else nrow(B)
  if (is.null(Y)) Y <- matrix(numeric(0), nrow=n, ncol=0L)
  if (is.null(B)) B <- matrix(numeric(0), nrow=n, ncol=0L)
  if (nrow(Y) != nrow(B)) stop("Y and B must have the same number of rows (DMUs).")
  storage.mode(Y) <- "double"; storage.mode(B) <- "double"
  if (any(!is.finite(Y)) || any(!is.finite(B))) stop("Y and B must contain only finite values.")
  if (any(Y < 0) || any(B < 0)) stop("Directional BoD requires nonnegative desirable and undesirable indicators.")

  ng <- ncol(Y); nb <- ncol(B); s <- ng + nb
  if (n < 1L || s < 1L) stop("At least one DMU and one indicator are required.")
  if (is.null(OY)) OY <- matrix(0, n, ng)
  if (is.null(OB)) OB <- matrix(0, n, nb)
  OY <- as.matrix(OY); OB <- as.matrix(OB)
  if (!all(dim(OY) == c(n, ng))) stop("OY must have the same dimensions as Y.")
  if (!all(dim(OB) == c(n, nb))) stop("OB must have the same dimensions as B.")

  R <- cbind(OY, OB)
  rr <- .tie_rank_info(R, SURROGATE, ALPHA)

  beta <- score <- rep(NA_real_, n)
  solver_status <- rep(NA_integer_, n)
  weights_desirable <- matrix(NA_real_, n, ng, dimnames=list(rownames(Y),colnames(Y)))
  weights_undesirable <- matrix(NA_real_, n, nb, dimnames=list(rownames(B),colnames(B)))
  virtual_share <- matrix(NA_real_, n, s)
  surrogate_share <- rr$tau

  for (o in seq_len(n)) {
    gy <- .direction_row(GY, Y, o, "GY")
    gb <- .direction_row(GB, B, o, "GB")
    if (sum(gy) + sum(gb) <= 0) stop("The directional vector must contain at least one positive component for every DMU.")

    if (RTS == "crs") {
      nv <- ng + nb; op <- om <- NA_integer_
    } else {
      nv <- ng + nb + 2L; op <- ng + nb + 1L; om <- ng + nb + 2L
    }

    obj <- numeric(nv)
    if (ng) obj[seq_len(ng)] <- -Y[o, ]
    if (nb) obj[ng + seq_len(nb)] <- B[o, ]
    if (RTS == "vrs") { obj[op] <- 1; obj[om] <- -1 }

    A <- list(); cdir <- character(); crhs <- numeric()
    add <- function(row, sense, rhs) {
      A[[length(A)+1L]] <<- row; cdir <<- c(cdir,sense); crhs <<- c(crhs,rhs)
    }

    for (j in seq_len(n)) {
      row <- numeric(nv)
      if (ng) row[seq_len(ng)] <- -Y[j, ]
      if (nb) row[ng + seq_len(nb)] <- B[j, ]
      if (RTS == "vrs") { row[op] <- 1; row[om] <- -1 }
      add(row, ">=", 0)
    }

    row <- numeric(nv)
    if (ng) row[seq_len(ng)] <- gy
    if (nb) row[ng + seq_len(nb)] <- gb
    add(row, "=", 1)

    if (rr$active) {
      tau <- rr$tau[o, ]; blocks <- rr$blocks[[o]]
      contrib <- vector("list", s)
      if (ng) for (r in seq_len(ng)) {
        z <- numeric(nv); z[r] <- gy[r]; contrib[[r]] <- z
      }
      if (nb) for (k in seq_len(nb)) {
        z <- numeric(nv); z[ng+k] <- gb[k]; contrib[[ng+k]] <- z
      }

      if (Weak) {
        # Equal contribution for tied priorities.
        for (bl in blocks) if (length(bl) > 1L) {
          for (k in bl[-1L]) add(contrib[[bl[1L]]] - contrib[[k]], "=", 0)
        }
        # Weak dominance between adjacent priority blocks.
        if (length(blocks) >= 2L) {
          for (h in seq_len(length(blocks)-1L)) {
            a <- blocks[[h]][1L]; b <- blocks[[h+1L]][1L]
            add(contrib[[a]] - contrib[[b]], ">=", Gamma * (tau[a] - tau[b]))
          }
        }
        # Surrogate floor for every member of the least-priority tie block.
        for (a in blocks[[length(blocks)]]) add(contrib[[a]], ">=", tau[a])
      } else {
        # Exact tie-adjusted surrogate shares; the last equality is redundant.
        if (s >= 2L) for (r in seq_len(s-1L)) add(contrib[[r]], "=", tau[r])
      }
    }

    fit <- lpSolve::lp(direction="min", objective.in=obj,
                       const.mat=do.call(rbind,A), const.dir=cdir, const.rhs=crhs)
    solver_status[o] <- fit$status
    if (fit$status == 0L) {
      beta[o] <- fit$objval
      if (beta[o] < 0 && beta[o] > -1e-8) beta[o] <- 0
      score[o] <- if (beta[o] >= 0) 1/(1+beta[o]) else NA_real_
      if (ng) weights_desirable[o,] <- fit$solution[seq_len(ng)]
      if (nb) weights_undesirable[o,] <- fit$solution[ng + seq_len(nb)]
      sh <- numeric(s)
      if (ng) sh[seq_len(ng)] <- gy * fit$solution[seq_len(ng)]
      if (nb) sh[ng + seq_len(nb)] <- gb * fit$solution[ng + seq_len(nb)]
      virtual_share[o,] <- sh
    }
  }

  yn <- if (ng) { z <- colnames(Y); if (is.null(z)) paste0("Y",seq_len(ng)) else z } else character(0)
  bn <- if (nb) { z <- colnames(B); if (is.null(z)) paste0("B",seq_len(nb)) else z } else character(0)
  rownames(virtual_share) <- rownames(surrogate_share) <- if (ng) rownames(Y) else rownames(B)
  colnames(virtual_share) <- c(yn,bn)
  colnames(surrogate_share) <- c(yn,bn)

  if (any(solver_status != 0L)) {
    warning(sum(solver_status != 0L), " LP(s) did not return an optimal solution; inspect solver_status.")
  }

  list(
    efficiency=score,
    score=score,
    beta=beta,
    weights_desirable=weights_desirable,
    weights_undesirable=weights_undesirable,
    virtual_share=virtual_share,
    surrogate_share=surrogate_share,
    ordinal_positions=rr$positions,
    tie_blocks=rr$blocks,
    solver_status=solver_status,
    preference = if (Gamma == 0) "weak" else if (Gamma == 1) "strict" else "moderate",
    Gamma = Gamma,
    Weak=Weak,
    tie_method="pooled positional surrogate mass",
    RTS=RTS,
    SURROGATE=toupper(SURROGATE),
    ALPHA=ALPHA,
    direction=if (is.null(GY) && is.null(GB)) "data direction" else "user supplied"
  )
}
