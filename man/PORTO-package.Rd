\name{PORTO-package}
\alias{PORTO-package}
\alias{PORTO}
\docType{package}
\title{PORTO: Preference and ORdinal Threshold Orientations}
\description{Ordinal DEA and Benefit-of-the-Doubt composite indicators, including radial and directional multiplier models, ties, and weak, moderate and strict preferences.}
\details{Four public functions are available: \code{\link{dea.order}}, \code{\link{dea.order.ties}}, \code{\link{dir.dea.order}}, and \code{\link{dir.dea.order.ties}}. The solver dependency is \pkg{lpSolve}. See the individual help pages for input orientation, the surrogate profiles, pooled tie treatment, and returned results. Smaller rank labels indicate higher priority. All supplied observations form the benchmark reference set.}
\author{Thyago Nepomuceno, Department of Statistics, Federal University of Pernambuco. Maintainer: \email{nepomuceno@de.ufpe.be}.}
\seealso{\code{\link{dea.order}}, \code{\link{dir.dea.order}}}
\keyword{package}
