gammas <- c(0, 0.25, 0.5, 0.75, 1)
scores <- sapply(gammas, function(g) {
  dir.dea.order.ties(Y = Y, B = B, OY = OY, OB = OB,
                     Gamma = g)$score
})
scores
}
